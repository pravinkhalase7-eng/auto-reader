# AI Teacher — VPS / Jenkins deploy env
# Create Jenkins credential:
#   Kind: Secret file
#   ID:   aiteacher-env-file
#   File: copy of this (filled in)

# --- Compose / host ports ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_USER=aiteacher
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aiteacher

# If the password contains #, spaces, or $, it MUST be quoted or bash/compose
# will treat # as a comment (Pravin#123 becomes just Pravin):
#   POSTGRES_PASSWORD='Pravin#123'
# DATABASE_URL must URL-encode that character as %23. Jenkins does this automatically.
DATABASE_URL=postgresql+asyncpg://aiteacher:change-me-strong-db-password@postgres:5432/aiteacher
SECRET_KEY=change-me-to-a-long-random-string
# Browser origin(s) for the UI — include your VPS IP/domain
CORS_ORIGINS=http://187.127.138.86:3000

AI_PROVIDER=local
OCR_PROVIDER=local
TTS_PROVIDER=browser
STORAGE_PROVIDER=local
SEED_ON_STARTUP=true

OPENAI_API_KEY=
# Gemini story pictures + Pavi agent — this name is required (not GOOGLE_API_KEY)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PAVI_AGENT_MODE=adk
PAVI_TTS_PROVIDER=mock
GEMINI_TTS_VOICE=Kore
ENABLE_DEV_TOOLS=false
DEFAULT_TIMEZONE=Asia/Kolkata
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public API origin Twilio fetches TwiML from (no /api/v1). HTTP is OK on this VPS.
TWILIO_WEBHOOK_BASE_URL=http://187.127.138.86:8000
VOICE_CALL_MODE=live
# Inside Docker this must be redis://redis:6379/0, not localhost
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Optional studio voices in the reader Voice menu (keeps browser voices too)
ELEVENLABS_API_KEY=

# --- Frontend (baked into Next.js at image build time) ---
# Must be the real VPS IP/domain — NOT the text YOUR_VPS_IP
NEXT_PUBLIC_API_URL=http://187.127.138.86:8000/api/v1
