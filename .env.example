# AI Teacher — Environment Example
# Copy to .env and fill in secrets. Never commit real .env files.

# --- Backend (apps/api) ---
DATABASE_URL=sqlite+aiosqlite:///./ai_teacher.db
# DATABASE_URL=postgresql+asyncpg://aiteacher:aiteacher@localhost:5432/aiteacher
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

AI_PROVIDER=local
OCR_PROVIDER=local
TTS_PROVIDER=browser
STORAGE_PROVIDER=local

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_CLOUD_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

SEED_ON_STARTUP=true

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
