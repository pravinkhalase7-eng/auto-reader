# AI Teacher — Environment Example
# Copy to .env and fill in secrets. Never commit real .env files.

# --- Backend (apps/api) ---
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./ai_teacher.db
# DATABASE_URL=postgresql+asyncpg://aiteacher:aiteacher@localhost:5432/aiteacher
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

AI_PROVIDER=local
OCR_PROVIDER=local
TTS_PROVIDER=browser
STORAGE_PROVIDER=local

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Story picture sequences use Gemini when GOOGLE_AI_API_KEY is set
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_CLOUD_API_KEY=

# Optional: adds ElevenLabs voices to the reader Voice menu (browser voices stay)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

SEED_ON_STARTUP=true

# --- Pavi assistant ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PAVI_AGENT_MODE=adk
PAVI_TTS_PROVIDER=mock
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public API origin (no /api/v1). Empty falls back to localhost, which Twilio cannot reach.
TWILIO_WEBHOOK_BASE_URL=

VOICE_CALL_MODE=mock
ENABLE_DEV_TOOLS=true
DEFAULT_TIMEZONE=Asia/Kolkata
CALL_MAX_RETRIES=1
CALL_RETRY_DELAYS_SECONDS=300,900

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
